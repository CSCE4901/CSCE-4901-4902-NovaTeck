# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=novatek_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
# For hosted MySQL, download its CA certificate into backend and set its filename.
DB_SSL_CA=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_PUBLIC_URL=http://127.0.0.1:3000
# Optional SMTP delivery for password reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Live DFW job synchronization (get credentials from developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_SYNC_LOCATION=Dallas, TX
JOB_SYNC_QUERY=technology
JOB_SYNC_PAGES=5
JOB_SYNC_RESULTS_PER_PAGE=50

# Nova AI career assistant (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
