        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "resume"
                ],
                "properties": {
                  "resume": {
                    "type": "string",
                    "format": "binary",
                    "description": "Text-based PDF or DOCX, maximum 5 MB. Not retained."
                  }
                }
              }
            }
          }
        }
      }
    },
