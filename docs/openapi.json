    "/students/{user_id}/resume": {
      "post": {
        "summary": "Process a bounded resume without retaining its file or plain text.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "description": "Owner or administrator access required"
          },
          "503": {
            "description": "Service unavailable"
          },
          "413": {
            "description": "File size exceeds the 5 MB limit."
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
